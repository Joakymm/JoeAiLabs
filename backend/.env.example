# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/joeailabs?retryWrites=true&w=majority

# ── Authentication ────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars
JWT_EXPIRE=7d

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key

# ── Payments ──────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ── Redis (optional — app works without it) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
